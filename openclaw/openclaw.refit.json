{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "cerebras/moonshotai-kimi-k3.1-pro-trial"
      },
      "thinkingDefault": "low"
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "cerebras": {
        "baseUrl": "http://127.0.0.1:18790/v1",
        "api": "openai-completions",
        "apiKey": "refit-local-proxy-placeholder",
        "models": [
          {
            "id": "moonshotai-kimi-k3.1-pro-trial",
            "name": "Kimi K3.1 Pro (Cerebras via refit HTTP2 proxy)",
            "reasoning": true,
            "input": ["text", "image"],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "compat": {
              "supportsTools": true,
              "supportsStrictMode": false,
              "supportsReasoningEffort": true,
              "supportedReasoningEfforts": ["low", "high", "max"]
            }
          },
          {
            "id": "qwen-3.8-27b",
            "name": "Qwen 3.8 27B (Cerebras WSE-3T via refit proxy)",
            "reasoning": true,
            "input": ["text"],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "compat": {
              "supportsTools": true,
              "supportsStrictMode": false,
              "supportsReasoningEffort": true,
              "supportedReasoningEfforts": ["low", "high", "max"]
            }
          }
        ]
      }
    }
  }
}
